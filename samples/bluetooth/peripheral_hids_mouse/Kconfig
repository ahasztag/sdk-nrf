menu "Nordic HIDS BLE GATT mouse service sample"

config SAMPLE_BT_HIDS_SECURITY
	bool "Bluetooth LE security"
	default y
	imply BT_PRIVACY
	select BT_SMP
	select BT_SETTINGS
	select FLASH
	select FLASH_PAGE_LAYOUT
	select FLASH_MAP
	select SETTINGS
	imply ZMS if (SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)
	imply NVS if !(SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)
	help
	  Enable Bluetooth LE security support.

config SAMPLE_BT_HIDS_SECURITY_MITM
	bool "Passkey display MITM protection"
	depends on SAMPLE_BT_HIDS_SECURITY
	depends on PRINTK
	default y
	help
	  Enable displaying passkey for Man-In-The-Middle (MITM) protection.
	  Implementation uses the "printk" function to display the passkey.

config SAMPLE_BT_DIRECTED_ADVERTISING
	bool "Directed advertising"
	default y
	depends on SAMPLE_BT_HIDS_SECURITY

config SAMPLE_BT_HIDS_CONTINUOUS_REPORT_SENDING
	bool "Continuous report sending"
	depends on BT_RADIO_NOTIFICATION_CONN_CB
	depends on BT_ATT_SENT_CB_AFTER_TX
	help
	  Enable the continuous report sending feature in the peripheral HIDS sample.
	  A designated button combination toggles continuous report sending on and off.
	  Note: Only one central device can receive continuous reports at a time.

endmenu

source "Kconfig.zephyr"
