menu "Nordic BLE HIDS Keyboard sample"

config SAMPLE_NFC_OOB_PAIRING
	bool "Enable NFC OOB pairing"
	depends on HAS_HW_NRF_NFCT
	default y
	select NFC_T2T_NRFXLIB
	select NFC_NDEF
	select NFC_NDEF_MSG
	select NFC_NDEF_RECORD
	select NFC_NDEF_LE_OOB_REC

config SETTINGS
	default y

config ZMS
	default y if (SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)

config NVS
	default y if !(SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)

config SAMPLE_BT_HIDS_CONTINUOUS_REPORT_SENDING
	bool "Continuous report sending"
	depends on BT_RADIO_NOTIFICATION_CONN_CB
	depends on BT_ATT_SENT_CB_AFTER_TX
	help
	  Enable the continuous report sending feature in the peripheral HIDS sample.
	  A designated button combination toggles continuous report sending on and off.
	  Note: Only one central device can receive continuous reports at a time.

endmenu

source "Kconfig.zephyr"
